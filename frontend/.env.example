# Copy to .env and fill in. Without VITE_API_URL every API call becomes
# `<this site's own origin>/undefined/api/...` — a 404 from Vite/whatever
# serves the built files, not the backend, which looks like the whole API is
# broken rather than one missing setting.
VITE_API_URL=

# Contact and Book a Demo submit through the backend's own SMTP mailer
# (backend/.env's SMTP_* settings) — nothing to configure here.
