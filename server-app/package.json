{
  "name": "vms-server",
  "productName": "CafeXP Console",
  "version": "1.0.0",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --publish never",
    "dist:publish": "electron-builder --win --publish always"
  },
  "dependencies": {
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "electron": "^41.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.managerxp.cafexp.console",
    "productName": "CafeXP Console",
    "artifactName": "CafeXP-Console-Setup-${version}.${ext}",
    "icon": "Images/icon.png",
    "files": [
      "**/*",
      "!legacy/**",
      "!**/*.log"
    ],
    "win": {
      "icon": "Images/icon.png",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": true,
      "perMachine": true,
      "allowElevation": true,
      "deleteAppDataOnUninstall": false,
      "installerIcon": "Images/icon.png",
      "uninstallerIcon": "Images/icon.png"
    }
  }
}
