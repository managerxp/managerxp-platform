# CafeXP Console (server-app) — copy to ".env" beside the installed exe.
#
# Read at startup from, in decreasing priority:
#   1. the folder holding the exe   <- what you edit on an installed console
#   2. the app's userData dir       (survives reinstalls/updates)
#   3. this source folder           (dev checkout only)
#
# Everything here is optional; without a .env the console uses whatever
# release.yml baked in at build time, which is correct for a normal install.

# ManagerXP's backend API — the VPS, not this machine. No trailing slash.
BACKEND_URL=https://managerxp.com

# The website — a DIFFERENT thing from BACKEND_URL even when it happens to
# be the same domain. "Open web app" / "Open signup" send a browser here;
# pointing it at the API would open a JSON response instead of a page.
WEB_APP_URL=https://managerxp.com

# Local HTTP port this console listens on for station discovery and for
# serving cached client updates to stations. Change only on a clash.
# TOKEN_SERVER_PORT=3334
